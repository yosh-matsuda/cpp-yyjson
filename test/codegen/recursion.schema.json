{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Program",
  "type": "object",
  "properties": {
    "body": {"$ref": "#/$defs/Expr"},
    "tree": {"$ref": "#/$defs/Node"},
    "tags": {"$ref": "#/$defs/Tags"}
  },
  "required": ["body"],
  "$defs": {
    "Expr": {
      "type": "object",
      "properties": {
        "op": {"type": "string", "default": "+"},
        "lhs": {"oneOf": [{"$ref": "#/$defs/Expr"}, {"$ref": "#/$defs/Literal"}]},
        "rhs": {"oneOf": [{"$ref": "#/$defs/Expr"}, {"$ref": "#/$defs/Literal"}]}
      },
      "required": ["op", "lhs", "rhs"],
      "additionalProperties": false
    },
    "Literal": {
      "type": "object",
      "properties": {"value": {"type": "number"}},
      "required": ["value"],
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/Node"}},
        "parent": {"anyOf": [{"$ref": "#/$defs/Node"}, {"type": "null"}], "default": null},
        "first": {"$ref": "#/$defs/Node", "default": {"name": "root"}}
      },
      "required": ["name"]
    },
    "Tags": {
      "description": "a tag, or a list of tags that are not empty",
      "oneOf": [
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/Tags"}, "minItems": 1}
      ]
    }
  }
}
